# SkillProof Configuration
# Copy this file to .env and fill in values

# GitHub Personal Access Token (optional - increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# OpenAI API Key (optional - enables AI summaries; leave blank for mock summaries)
OPENAI_API_KEY=

# Database URL (default: SQLite)
DATABASE_URL=sqlite:///./skillproof.db

# Server
HOST=0.0.0.0
PORT=8000
